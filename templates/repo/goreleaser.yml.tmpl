# Code generated by biscuit. DO NOT EDIT.
version: 2
project_name: {{.Binary}}

before:
  hooks:
    - go run ./scripts/gendocs --dir dist/docsgen

builds:
  - main: ./cmd/{{.Binary}}
    binary: {{.Binary}}
    env:
      - CGO_ENABLED=0
    goos:
      - darwin
      - linux
      - windows
    goarch:
      - amd64
      - arm64
      - "386"
    ignore:
      - goos: darwin
        goarch: "386"
      - goos: windows
        goarch: "386"
    ldflags:
      - -s -w
      - -X {{.Module}}/cmd/{{.Binary}}.version={{ob}}.Version{{cb}}

archives:
  - formats: [tar.gz]
    format_overrides:
      - goos: windows
        formats: [zip]
    files:
      - LICENSE*
      - README*
      - CHANGELOG*
      - license*
      - readme*
      - changelog*
      - src: dist/docsgen/man/*
        dst: man
      - src: dist/docsgen/completions/*
        dst: completions

checksum:
  name_template: checksums.txt

changelog:
  disable: true # release-please owns the changelog

release:
  prerelease: auto
{{if .Homebrew}}
# two channels mirroring npm's dist-tags: {{.Binary}}-cli tracks stable
# releases only (like npm `latest`), {{.Binary}}-cli@next tracks every release
# (like npm `next`) — one prerelease channel for any maturity (alpha/beta/rc
# live in the version string)
homebrew_casks:
  # named {{.Binary}}-cli to match the npm package; the installed command stays `{{.Binary}}`
  - name: {{.Binary}}-cli
    skip_upload: auto # prerelease tags leave the stable cask untouched
    repository:
      {{if eq .RepoOwner "OWNER"}}# TODO: module path isn't github.com/<owner>/<repo> — set owner below
      {{end}}owner: {{.TapOwner}}
      name: homebrew-tap
      token: "{{ob}} .Env.HOMEBREW_TAP_TOKEN {{cb}}"
    directory: Casks
    binaries: [{{.Binary}}] # cask is named {{.Binary}}-cli; the archive's binary is not
    # every listed page must exist in dist/docsgen/man — one per top-level command
    manpages:
      - man/{{.Binary}}.1
{{- range .Resources}}
      - man/{{$.Binary}}-{{.Name}}.1
{{- end}}
{{- range .RootVerbs}}
      - man/{{$.Binary}}-{{.Use}}.1
{{- end}}
    completions:
      bash: completions/{{.Binary}}.bash
      zsh: completions/_{{.Binary}}
      fish: completions/{{.Binary}}.fish
    caveats: |
      Installed command: {{.Binary}}   (stable channel)

        Get started:          {{.Binary}} --help
        Upgrade:              brew upgrade {{.Binary}}-cli
        Prerelease channel:   brew uninstall --cask {{.Binary}}-cli && brew install {{.TapOwner}}/tap/{{.Binary}}-cli@next

      Conflicts with {{.Binary}}-cli@next (both install `{{.Binary}}`) — keep only one.
    homepage: https://github.com/{{.RepoOwner}}/{{.RepoName}}
    description: {{q .Title}}
    # unsigned binaries: strip the quarantine attribute so macOS runs them
    hooks:
      post:
        install: |
          if system_command("/usr/bin/xattr", args: ["-h"]).exit_status == 0
            system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{staged_path}/{{.Binary}}"]
          end
  - name: {{.Binary}}-cli@next
    repository:
      {{if eq .RepoOwner "OWNER"}}# TODO: module path isn't github.com/<owner>/<repo> — set owner below
      {{end}}owner: {{.TapOwner}}
      name: homebrew-tap
      token: "{{ob}} .Env.HOMEBREW_TAP_TOKEN {{cb}}"
    directory: Casks
    binaries: [{{.Binary}}]
    manpages:
      - man/{{.Binary}}.1
{{- range .Resources}}
      - man/{{$.Binary}}-{{.Name}}.1
{{- end}}
{{- range .RootVerbs}}
      - man/{{$.Binary}}-{{.Use}}.1
{{- end}}
    completions:
      bash: completions/{{.Binary}}.bash
      zsh: completions/_{{.Binary}}
      fish: completions/{{.Binary}}.fish
    caveats: |
      Installed command: {{.Binary}}   (prerelease channel — alpha/beta/rc builds)

        Get started:        {{.Binary}} --help
        Upgrade:            brew upgrade {{.Binary}}-cli@next
        Switch to stable:   brew uninstall --cask {{.Binary}}-cli@next && brew install {{.TapOwner}}/tap/{{.Binary}}-cli

      Conflicts with the stable {{.Binary}}-cli cask (both install `{{.Binary}}`) — keep only one.
    homepage: https://github.com/{{.RepoOwner}}/{{.RepoName}}
    description: {{q (printf "%s (prerelease channel)" .Title)}}
    hooks:
      post:
        install: |
          if system_command("/usr/bin/xattr", args: ["-h"]).exit_status == 0
            system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{staged_path}/{{.Binary}}"]
          end
{{end}}